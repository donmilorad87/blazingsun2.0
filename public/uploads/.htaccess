# Admin uploads (images only, written by the API with random names). Nothing here is ever executed, and an SVG
# opened directly can't run scripts. Deployed with the site; the uploaded files themselves are never in dist/.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar

<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|html?)$">
	Require all denied
</FilesMatch>

<IfModule mod_headers.c>
	Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
	Header set X-Content-Type-Options "nosniff"
	Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
