# Template for .env (git-ignored): cp .env.example .env, then fill in the values.
# Same names as the GitHub Actions secrets. Only if a value contains $, a space or #, wrap it in single quotes.

# Deploy over SSH (hPanel → Advanced → SSH Access). Locally: the path of your private key file.
SSH_HOST=
SSH_PORT=
SSH_USER=
SSH_KEY_FILE=
# Site root, relative to the SSH home folder. On Hostinger: domains/<your-domain>/public_html
DEPLOY_PATH=

# Production database
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# API
MIGRATION_TOKEN=
# Public origin, for canonical and hreflang links. Optional: defaults to https://blazingsun.space
SITE_URL=

# Admin portal (/adminportal). The plain password (at least 12 characters): the deploy stores only its hash on the server.
# Local Docker uses them too (empty = blazingsun / blazingsun). On deploy, an empty ADMIN_USERNAME disables the admin login.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Local Docker stack (empty = defaults: 80, 3307, 1000, 1000)
BLAZINGSUN_HTTP_PORT=
BLAZINGSUN_DB_PORT=
LOCAL_UID=
LOCAL_GID=
