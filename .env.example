# Template for .env (git-ignored): cp .env.example .env, then fill in the values.
# Same names as the GitHub Actions secrets. Only if a value contains $, a space or #, wrap it in single quotes.

# FTP
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=

# Production database
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# API
MIGRATION_TOKEN=

# Local Docker stack (empty = defaults: 8080, 3307, 1000, 1000)
BLAZINGSUN_HTTP_PORT=
BLAZINGSUN_DB_PORT=
LOCAL_UID=
LOCAL_GID=
